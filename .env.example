# Copy to .env and fill in. Never commit real secrets.
# Variables marked (Phase N) are not used yet and may stay empty until that phase.

# --- Core -------------------------------------------------------------------
APP_URL="http://localhost:3000"
DATABASE_URL="postgresql://whatsflow:whatsflow@localhost:5432/whatsflow"
REDIS_URL="redis://localhost:6379"
LOG_LEVEL="info"

# --- Auth -------------------------------------------------------------------
# Used to HMAC session, verification and reset tokens before storage.
# Generate with: openssl rand -base64 48
# (Replaces NEXTAUTH_SECRET from the original brief; see docs/ARCHITECTURE.md section 2.)
AUTH_SECRET=""

# AES-256-GCM key for encrypting stored credentials such as Meta access tokens (Phase 3).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Email ------------------------------------------------------------------
# Defaults match the Mailpit container in docker-compose.yml.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
EMAIL_FROM="WhatsFlow <no-reply@example.com>"
# "smtp" (default) or "memory" (tests only)
EMAIL_PROVIDER="smtp"

# --- WhatsApp Business Platform (Phase 3) -----------------------------------
# All Meta API details are pending verification: see docs/META_API_VERIFICATION.md.
WHATSAPP_GRAPH_API_VERSION=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# --- Object storage (Phase 2/4) ---------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="whatsflow"
S3_SECRET_KEY="whatsflow-secret"
S3_BUCKET="whatsflow"

# --- Billing (Phase 9) ------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Branding (optional overrides of src/config/brand.ts) -------------------
NEXT_PUBLIC_BRAND_PRODUCT_NAME=""
NEXT_PUBLIC_BRAND_COMPANY_NAME=""
NEXT_PUBLIC_BRAND_LOGO_PATH=""
NEXT_PUBLIC_BRAND_DOMAIN=""
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=""

# --- Tests ------------------------------------------------------------------
TEST_DATABASE_URL="postgresql://whatsflow:whatsflow@localhost:5432/whatsflow_test"
E2E_DATABASE_URL="postgresql://whatsflow:whatsflow@localhost:5432/whatsflow_e2e"
