// Phase 1: identity, sessions, workspaces, membership, audit.
// Phase 2: contacts, tags, lists, notes, custom fields, segments, CSV imports.
// Phase 3: WhatsApp accounts (Embedded Signup), encrypted credentials, webhooks.
// Phase 4: templates, conversations, messages, message events, media.
// See docs/DATABASE.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  AGENT
  ANALYST
}

enum OptInStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum ContactSource {
  MANUAL
  IMPORT
  API
  INBOUND
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
}

enum ImportStatus {
  UPLOADED
  RUNNING
  COMPLETED
  FAILED
}

enum WhatsAppAccountStatus {
  // Embedded Signup finished but onboarding calls (subscribe/register) not yet successful.
  PENDING_SETUP
  CONNECTED
  // Meta rejected our token (e.g. revoked); the customer must reconnect.
  NEEDS_RECONNECT
  RESTRICTED
  DISCONNECTED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  // Stored but no handler existed when it arrived; replayed once a handler exists.
  DEFERRED
  IGNORED
  FAILED
}

enum OnboardingStep {
  BUSINESS
  WHATSAPP
  CONTACTS
  TEMPLATES
  DONE
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique // stored lowercased
  passwordHash    String?
  emailVerifiedAt DateTime?
  avatarUrl       String?
  isPlatformAdmin Boolean   @default(false)
  isDemo          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions                Session[]
  oauthAccounts           OAuthAccount[]
  memberships             WorkspaceMember[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  invitesSent             WorkspaceInvite[]        @relation("InviteSender")
  auditLogs               AuditLog[]
  contactNotes            ContactNote[]
  importJobs              ImportJob[]
  whatsAppAccounts        WhatsAppAccount[]
  templatesCreated        Template[]
  assignedConversations   Conversation[]
  conversationNotes       ConversationNote[]
  messagesSent            Message[]
}

// Reserved for Google/Microsoft/SSO login. Not used in Phase 1.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// The id is the SHA-256 hash of the session token held in the cookie, so a
// database leak does not yield usable session tokens.
model Session {
  id         String   @id
  userId     String
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  businessName   String?
  logoUrl        String?
  timezone       String         @default("UTC")
  currency       String         @default("USD")
  // ISO 3166-1 alpha-2, used to interpret phone numbers entered without a country code.
  defaultCountry String?
  planId         String         @default("free")
  onboardingStep OnboardingStep @default(BUSINESS)
  isDemo         Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  members           WorkspaceMember[]
  invites           WorkspaceInvite[]
  auditLogs         AuditLog[]
  contacts          Contact[]
  tags              Tag[]
  contactTags       ContactTag[]
  contactLists      ContactList[]
  listMembers       ContactListMember[]
  contactNotes      ContactNote[]
  customFields      CustomFieldDefinition[]
  segments          Segment[]
  importJobs        ImportJob[]
  importRowErrors   ImportRowError[]
  credentials       Credential[]
  whatsAppAccounts  WhatsAppAccount[]
  webhookEvents     WebhookEvent[]
  providerApiLogs   ProviderApiLog[]
  templates         Template[]
  conversations     Conversation[]
  conversationNotes ConversationNote[]
  messages          Message[]
  messageEvents     MessageEvent[]
  mediaObjects      MediaObject[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
}

// Append-only. workspaceId is null for account-level events such as login.
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Phase 2: contacts
// ---------------------------------------------------------------------------

model Contact {
  id                    String        @id @default(cuid())
  workspaceId           String
  // As entered by the user or file; normalizedPhoneNumber (E.164) is the identity.
  phoneNumber           String
  normalizedPhoneNumber String
  firstName             String?
  lastName              String?
  email                 String?
  company               String?
  country               String? // ISO 3166-1 alpha-2
  profileImageUrl       String?
  optInStatus           OptInStatus   @default(UNKNOWN)
  optInSource           String?
  optInAt               DateTime?
  optedOutAt            DateTime?
  customFields          Json          @default("{}")
  source                ContactSource @default(MANUAL)
  // Maintained by messaging (Phase 4).
  lastMessageAt         DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tags          ContactTag[]
  lists         ContactListMember[]
  notes         ContactNote[]
  conversations Conversation[]
  messages      Message[]

  @@unique([workspaceId, normalizedPhoneNumber])
  @@index([workspaceId, createdAt(sort: Desc), id])
  @@index([workspaceId, firstName, id])
  @@index([workspaceId, optInStatus])
  @@index([workspaceId, email])
  @@index([workspaceId, lastMessageAt])
  @@index([customFields], type: Gin)
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("gray")
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]

  @@unique([workspaceId, name])
}

// workspaceId is denormalized onto join tables so every tenant table can be scoped directly.
model ContactTag {
  workspaceId String
  contactId   String
  tagId       String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([workspaceId, tagId])
}

model ContactList {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ContactListMember[]

  @@unique([workspaceId, name])
}

model ContactListMember {
  workspaceId String
  listId      String
  contactId   String
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([workspaceId, contactId])
}

// Internal notes about a contact. Never sent to the contact.
model ContactNote {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  authorId    String?
  body        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, contactId, createdAt(sort: Desc)])
}

model CustomFieldDefinition {
  id          String          @id @default(cuid())
  workspaceId String
  // Key used in Contact.customFields, CSV mapping and template variables.
  key         String
  label       String
  type        CustomFieldType @default(TEXT)
  createdAt   DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

// Saved audience. `definition` is a validated condition tree (see src/lib/segments.ts).
model Segment {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  definition  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

// CSV import. The uploaded file is kept only until the import runs, then cleared.
model ImportJob {
  id           String       @id @default(cuid())
  workspaceId  String
  createdById  String?
  fileName     String
  fileSize     Int
  status       ImportStatus @default(UPLOADED)
  csvContent   String?
  headers      Json
  rowCount     Int
  mapping      Json?
  options      Json?
  createdCount Int          @default(0)
  updatedCount Int          @default(0)
  skippedCount Int          @default(0)
  failedCount  Int          @default(0)
  completedAt  DateTime?
  createdAt    DateTime     @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  errors    ImportRowError[]

  @@index([workspaceId, createdAt(sort: Desc)])
}

model ImportRowError {
  id          String @id @default(cuid())
  workspaceId String
  importJobId String
  rowNumber   Int
  data        Json
  errors      String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, rowNumber])
}

// ---------------------------------------------------------------------------
// Phase 3: WhatsApp connection and webhooks
// ---------------------------------------------------------------------------

// Encrypted secret (AES-256-GCM, see src/server/crypto/secrets.ts). Never sent to clients.
model Credential {
  id          String   @id @default(cuid())
  workspaceId String
  kind        String // e.g. "meta_business_token", "meta_registration_pin"
  ciphertext  String
  iv          String
  authTag     String
  keyId       String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WhatsAppAccount {
  id                     String                @id @default(cuid())
  workspaceId            String
  provider               String                @default("META_CLOUD")
  businessAccountId      String // WABA ID
  businessPortfolioId    String?
  // Globally unique: a phone number can only be connected to one workspace.
  phoneNumberId          String                @unique
  displayPhoneNumber     String?
  verifiedName           String?
  status                 WhatsAppAccountStatus @default(PENDING_SETUP)
  statusDetail           String? // user-safe explanation of the current status
  qualityRating          String?
  messagingLimit         String?
  nameStatus             String?
  codeVerificationStatus String?
  throughputLevel        String?
  accessTokenRef         String?
  registrationPinRef     String?
  webhooksSubscribedAt   DateTime?
  registeredAt           DateTime?
  lastSyncedAt           DateTime?
  connectedById          String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy   User?          @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  conversations Conversation[]
  messages      Message[]

  @@index([workspaceId])
  @@index([businessAccountId])
}

// Raw webhook deliveries, one row per change. dedupeKey makes processing idempotent
// across Meta's retries (up to 7 days).
model WebhookEvent {
  id                String             @id @default(cuid())
  provider          String             @default("META")
  dedupeKey         String
  workspaceId       String?
  whatsappAccountId String?
  eventType         String // webhook field, e.g. "messages", "account_update"
  payload           Json
  status            WebhookEventStatus @default(RECEIVED)
  attempts          Int                @default(0)
  error             String?
  processedAt       DateTime?
  createdAt         DateTime           @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([provider, dedupeKey])
  @@index([status, createdAt])
  @@index([workspaceId, createdAt(sort: Desc)])
}

// Metadata of calls to Meta (never tokens or message bodies), for debugging failures.
model ProviderApiLog {
  id                String   @id @default(cuid())
  workspaceId       String?
  whatsappAccountId String?
  operation         String
  method            String
  path              String
  statusCode        Int?
  success           Boolean
  durationMs        Int
  errorCode         Int?
  errorSubcode      Int?
  errorMessage      String?
  fbtraceId         String?
  requestId         String?
  createdAt         DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([whatsappAccountId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Phase 4: templates, inbox, messaging, media
// ---------------------------------------------------------------------------

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

// Meta's template statuses (WA/reference/whatsapp-business-account/message-template-api),
// plus DRAFT for templates not yet submitted. Only APPROVED templates can be sent.
enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
  FLAGGED
  IN_APPEAL
  ARCHIVED
  LIMIT_EXCEEDED
  LOCKED
  PENDING_DELETION
  DELETED
  UNKNOWN
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// Outbound progresses QUEUED -> SENDING -> ACCEPTED -> SENT -> DELIVERED -> READ, or ends FAILED.
// ACCEPTED means Meta's API accepted the request; SENT/DELIVERED/READ come only from status webhooks.
enum MessageStatus {
  QUEUED
  SENDING
  ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum MediaStatus {
  PENDING
  STORED
  FAILED
}

// A template belongs to a WhatsApp Business Account (WABA), so it is keyed by businessAccountId.
model Template {
  id                 String           @id @default(cuid())
  workspaceId        String
  businessAccountId  String
  providerTemplateId String?
  name               String
  language           String
  category           TemplateCategory
  status             TemplateStatus   @default(DRAFT)
  // "POSITIONAL" ({{1}}) or "NAMED" ({{first_name}})
  parameterFormat    String           @default("POSITIONAL")
  // Meta's component array (HEADER, BODY, FOOTER, BUTTONS), as submitted or synced.
  components         Json
  rejectionReason    String?
  lastSyncedAt       DateTime?
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  messages  Message[]

  @@unique([workspaceId, businessAccountId, name, language])
  @@index([workspaceId, status])
  @@index([providerTemplateId])
}

// One thread per contact per business phone number.
model Conversation {
  id                 String             @id @default(cuid())
  workspaceId        String
  contactId          String
  whatsappAccountId  String
  status             ConversationStatus @default(OPEN)
  assignedUserId     String?
  unreadCount        Int                @default(0)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  // Last customer message; the 24-hour customer service window runs from here.
  lastInboundAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact         Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsAppAccount    @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  assignedUser    User?              @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages        Message[]
  notes           ConversationNote[]

  @@unique([workspaceId, contactId, whatsappAccountId])
  @@index([workspaceId, status, lastMessageAt(sort: Desc)])
  @@index([workspaceId, assignedUserId, lastMessageAt(sort: Desc)])
}

// Internal team notes. Stored apart from Message so they can never reach the send path.
model ConversationNote {
  id             String   @id @default(cuid())
  workspaceId    String
  conversationId String
  authorId       String?
  body           String
  createdAt      DateTime @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, conversationId, createdAt])
}

model Message {
  id                String           @id @default(cuid())
  workspaceId       String
  conversationId    String
  contactId         String
  whatsappAccountId String
  direction         MessageDirection
  // text, image, video, audio, document, sticker, location, contacts, interactive, button, reaction, template, unsupported
  type              String
  // Text, caption, or the rendered template text.
  body              String?
  mediaObjectId     String?
  templateId        String?
  // { header?, body?, buttons? } values used to fill the template
  templateParams    Json?
  // Type-specific extra details (location, reply ids, shared contacts).
  payload           Json?
  // wamid of the message this replies to or reacts to.
  contextMessageId  String?
  whatsappMessageId String?
  // Client-supplied key that makes a send request safe to repeat.
  idempotencyKey    String?
  status            MessageStatus
  errorCode         Int?
  errorMessage      String?
  attempts          Int              @default(0)
  sentById          String?
  queuedAt          DateTime?
  acceptedAt        DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  // Inbound: the customer's send time from the webhook.
  receivedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation    Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact         Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  template        Template?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  mediaObject     MediaObject?    @relation(fields: [mediaObjectId], references: [id], onDelete: SetNull)
  sentBy          User?           @relation(fields: [sentById], references: [id], onDelete: SetNull)
  events          MessageEvent[]

  @@unique([workspaceId, whatsappMessageId])
  @@unique([workspaceId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, status])
}

// Immutable record of each status change, from Meta's webhooks or our send attempts.
// Analytics are computed from these rows. One row per message and type.
model MessageEvent {
  id          String   @id @default(cuid())
  workspaceId String
  messageId   String
  // QUEUED, ACCEPTED, SENT, DELIVERED, READ, PLAYED, FAILED, RECEIVED
  type        String
  occurredAt  DateTime
  errorCode   Int?
  errorTitle  String?
  // Meta's pricing object on status webhooks (category, type), when present.
  pricing     Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, type])
  @@index([workspaceId, type, occurredAt])
}

// A file in object storage: received from customers or uploaded by the team.
model MediaObject {
  id                 String      @id @default(cuid())
  workspaceId        String
  storageKey         String?
  mimeType           String
  size               Int?
  fileName           String?
  sha256             String?
  // Meta media id (incoming: from the webhook; outgoing: from the upload API).
  providerMediaId    String?
  // Outgoing uploads: which business number uploaded it and when (ids are valid for 30 days).
  providerPhoneId    String?
  providerUploadedAt DateTime?
  status             MediaStatus @default(PENDING)
  error              String?
  uploadedById       String?
  createdAt          DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([workspaceId, createdAt(sort: Desc)])
}
