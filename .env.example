# Copy to .env and fill in. Never commit real secrets.
# Variables marked (Phase N) are not used yet and may stay empty until that phase.

# --- Core -------------------------------------------------------------------
APP_URL="http://localhost:3000"
DATABASE_URL="postgresql://whatsflow:whatsflow@localhost:5432/whatsflow"
REDIS_URL="redis://localhost:6379"
# Separate queues per environment when several share one Redis server
QUEUE_PREFIX="whatsflow"
LOG_LEVEL="info"

# --- Auth -------------------------------------------------------------------
# Used to HMAC session, verification and reset tokens before storage.
# Generate with: openssl rand -base64 48
# (Replaces NEXTAUTH_SECRET from the original brief; see docs/ARCHITECTURE.md section 2.)
AUTH_SECRET=""

# AES-256-GCM key for encrypting stored credentials (Meta access tokens, phone PINs).
# Required when WhatsApp is configured. Generate with: openssl rand -base64 32
# Back it up: losing it means every WhatsApp connection must be reconnected.
ENCRYPTION_KEY=""
ENCRYPTION_KEY_ID="k1"
# During key rotation only: the old key and its id
ENCRYPTION_KEY_PREVIOUS=""
ENCRYPTION_KEY_PREVIOUS_ID=""

# --- Email ------------------------------------------------------------------
# Defaults match the Mailpit container in docker-compose.yml.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
EMAIL_FROM="WhatsFlow <no-reply@example.com>"
# "smtp" (default) or "memory" (tests only)
EMAIL_PROVIDER="smtp"

# --- WhatsApp Business Platform ---------------------------------------------
# Your Meta app, registered as a Tech Provider and used for Embedded Signup
# ("Connect with Facebook"). See docs/META_SETUP_GUIDE.md for where to find each value.
# Leave all four empty to run without WhatsApp; set all four to enable it.
# Each business's own access token is obtained through Embedded Signup and stored
# encrypted in the database, so there is no global WhatsApp access token or
# WhatsApp Business Account ID here.
WHATSAPP_APP_ID=""
WHATSAPP_APP_SECRET=""
# Facebook Login for Business > Configurations > your Embedded Signup configuration ID
WHATSAPP_CONFIG_ID=""
# Any long random string; enter the same value as "Verify token" in the App Dashboard webhooks settings
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_GRAPH_API_VERSION="v25.0"
# Tests only: point the server at a fake Graph API. Leave empty in real deployments.
WHATSAPP_GRAPH_BASE_URL=""

# --- Object storage (media files) -------------------------------------------
# "local" stores files on disk (development; web and worker must share the folder).
# "s3" uses AWS S3 or any S3-compatible service (MinIO in docker-compose, Cloudflare R2, ...).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="whatsflow"
S3_SECRET_KEY="whatsflow-secret"
S3_BUCKET="whatsflow"
# Path-style URLs (needed for MinIO). Set to "false" for AWS virtual-hosted style.
S3_FORCE_PATH_STYLE="true"

# --- Worker -----------------------------------------------------------------
# Optional: serve GET / with {"status":"ok"} on this port (127.0.0.1) for health checks.
WORKER_HEALTH_PORT=""

# --- Billing (Phase 9) ------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Branding (optional overrides of src/config/brand.ts) -------------------
NEXT_PUBLIC_BRAND_PRODUCT_NAME=""
NEXT_PUBLIC_BRAND_COMPANY_NAME=""
NEXT_PUBLIC_BRAND_LOGO_PATH=""
NEXT_PUBLIC_BRAND_DOMAIN=""
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=""

# --- Tests ------------------------------------------------------------------
TEST_DATABASE_URL="postgresql://whatsflow:whatsflow@localhost:5432/whatsflow_test"
E2E_DATABASE_URL="postgresql://whatsflow:whatsflow@localhost:5432/whatsflow_e2e"
